# Database
DATABASE_URL=postgresql://afi:password@localhost:5432/afi_db

# JWT (générer : python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# IA — fournisseur OpenAI-compatible (gratuit : Groq, Gemini, Ollama)
# - Groq   : OPENAI_API_KEY=gsk_... ; OPENAI_BASE_URL=https://api.groq.com/openai/v1 ; OPENAI_MODEL=llama-3.3-70b-versatile
# - Gemini : OPENAI_API_KEY=AIza... ; OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ ; OPENAI_MODEL=gemini-2.0-flash
# - Ollama : OPENAI_API_KEY=ollama  ; OPENAI_BASE_URL=http://localhost:11434/v1      ; OPENAI_MODEL=llama3.2
# Sans clé : fallback local (règles sur les vraies données) — les tests passent sans clé.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# SMTP (emails de réinitialisation de mot de passe)
# Ex. Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=mail@gmail.com,
#             SMTP_PASSWORD=<mot de passe d'application 16 lettres>, SMTP_FROM=mail@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=afi@example.com

# Redis
REDIS_URL=redis://localhost:6379

# App
APP_NAME=AFI - Assistant Financier Intelligent
APP_VERSION=1.0.0
DEBUG=True

# CORS (en production, lister les origines autorisées, ex. "https://app.afi.com,https://admin.afi.com")
# CORS_ORIGINS=["https://app.afi.com"]